# Build-input allowlist: never send local credentials, models or Cargo caches
# to the Docker daemon. Keep this aligned with Dockerfile COPY instructions.
**
!Cargo.toml
!Cargo.lock
!examples/
!examples/**
!native/
!native/**
!vendor/
!vendor/**
!src/
!src/**
!build.rs
!frontend/
!frontend/**
frontend/node_modules
frontend/dist
!models.sha256.json

**/.git
**/target
**/build
**/node_modules

# llama.cpp inference builds do not consume upstream test model fixtures.
vendor/llama.cpp/models
vendor/llama.cpp/tests
vendor/llama.cpp/docs
vendor/llama.cpp/media
# Exclude developer credentials and model weights even below allowlisted trees.
**/.env
**/.env.*
**/tokens.json
**/*.onnx
**/*.gguf
**/*.safetensors
