{
  "name": "sonicboom-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host localhost",
    "typecheck": "node scripts/check-i18n.mjs && vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "node --experimental-strip-types --import ./tests/register-resolver.mjs --import ./tests/setup-dom.mjs --test tests/cloneValidation.test.ts tests/pocketActivation.test.ts tests/studioRefresh.test.ts tests/synthesisIsolation.test.ts && node --test tests/engineCard.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.4",
    "reka-ui": "^2.11.0",
    "vue": "3.5.44",
    "wavesurfer.js": "^8.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
